{
  "manifest_version": 3,
  "name": "No Pub",
  "version": "1.0.3",
  "description": "Passe les pubs sur MyCanal/Canal+ et YouTube.",
  "browser_specific_settings": {
    "gecko": {
      "id": "nopub-extension@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "host_permissions": ["*://*.canalplus.com/*", "*://*.youtube.com/*"],
  "action": {},
  "background": { "scripts": ["background.js"] },
  "content_scripts": [
    {
      "matches": ["*://*.canalplus.com/*", "*://*.youtube.com/*"],
      "js": ["canalplus_block.js"]
    }
  ]
}
